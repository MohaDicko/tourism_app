@model TourismApp.Web.ViewModels.EndroitFormViewModel
@{
    ViewData["Title"] = "Modifier le Site - " + Model.Nom;
}

<div class="content-card">
    <div class="d-flex justify-content-between align-items-center mb-4 pb-2 border-bottom">
        <h4 class="fw-bold mb-0 text-dark">Modifier le Site</h4>
        <a asp-action="Details" asp-route-id="@Model.Id" class="btn btn-sm btn-outline-secondary">
            <i class="bi bi-arrow-left me-1"></i>Retour aux détails
        </a>
    </div>

    <form asp-action="Edit" asp-route-id="@Model.Id" method="post" enctype="multipart/form-data">
        @Html.AntiForgeryToken()
        <input type="hidden" asp-for="Id" />

        <div class="row g-4">
            <div class="col-lg-7">
                <!-- Nom -->
                <div class="mb-3">
                    <label asp-for="Nom" class="form-label text-muted small fw-semibold">Nom</label>
                    <input asp-for="Nom" class="form-control" required />
                    <span asp-validation-for="Nom" class="text-danger small"></span>
                </div>

                <!-- Longitude & Latitude -->
                <div class="row g-3 mb-3">
                    <div class="col-md-6">
                        <label asp-for="Longitude" class="form-label text-muted small fw-semibold">Longitude</label>
                        <input asp-for="Longitude" class="form-control" id="inputLongitude" step="any" required />
                        <span asp-validation-for="Longitude" class="text-danger small"></span>
                    </div>
                    <div class="col-md-6">
                        <label asp-for="Latitude" class="form-label text-muted small fw-semibold">Latitude</label>
                        <input asp-for="Latitude" class="form-control" id="inputLatitude" step="any" required />
                        <span asp-validation-for="Latitude" class="text-danger small"></span>
                    </div>
                </div>

                <!-- GSM -->
                <div class="mb-3">
                    <label asp-for="Numero" class="form-label text-muted small fw-semibold">GSM</label>
                    <input asp-for="Numero" class="form-control" />
                    <span asp-validation-for="Numero" class="text-danger small"></span>
                </div>

                <!-- Description -->
                <div class="mb-3">
                    <label asp-for="Description" class="form-label text-muted small fw-semibold">Description</label>
                    <textarea asp-for="Description" class="form-control" rows="4"></textarea>
                    <span asp-validation-for="Description" class="text-danger small"></span>
                </div>

                <!-- Statut -->
                <div class="mb-3">
                    <label asp-for="Statut" class="form-label text-muted small fw-semibold">Statut</label>
                    <select asp-for="Statut" class="form-select">
                        <option value="1">Ouvert</option>
                        <option value="0">Fermé</option>
                        <option value="2">En travaux / Rénovation</option>
                    </select>
                </div>

                <!-- Type -->
                <div class="mb-3">
                    <label asp-for="TypeCategorie" class="form-label text-muted small fw-semibold">Type</label>
                    <select asp-for="TypeCategorie" class="form-select">
                        <option value="Place Publique">Place Publique</option>
                        <option value="Monument">Monument</option>
                        <option value="Musée">Musée</option>
                        <option value="Jardin">Jardin</option>
                        <option value="Restaurant">Restaurant</option>
                        <option value="Café">Café</option>
                        <option value="Hôtel">Hôtel / Hébergement</option>
                        <option value="Shopping">Shopping / Souks</option>
                        <option value="Hôpitale">Santé / Hôpital</option>
                        <option value="Aéroport">Transport Public / Aéroport</option>
                        <option value="Administration">Administration</option>
                    </select>
                </div>

                <!-- Image Upload -->
                <div class="mb-3">
                    <label asp-for="ImageFile" class="form-label text-muted small fw-semibold">Remplacer l'image</label>
                    <input asp-for="ImageFile" type="file" class="form-control" accept="image/*" />
                    @if (!string.IsNullOrEmpty(Model.ExistingImageUrl))
                    {
                        <div class="mt-2 small text-muted">
                            Image actuelle : <a href="@Model.ExistingImageUrl" target="_blank">Voir l'image</a>
                        </div>
                    }
                </div>

                <!-- Audio Upload -->
                <div class="mb-4">
                    <label asp-for="AudioFile" class="form-label text-muted small fw-semibold">Remplacer le guide audio</label>
                    <input asp-for="AudioFile" type="file" class="form-control" accept="audio/*" />
                    @if (!string.IsNullOrEmpty(Model.ExistingAudioUrl))
                    {
                        <div class="mt-2 small text-muted">
                            Fichier audio actuel : <a href="@Model.ExistingAudioUrl" target="_blank">Écouter</a>
                        </div>
                    }
                </div>

                <div class="d-flex gap-2">
                    <a asp-action="Details" asp-route-id="@Model.Id" class="btn btn-secondary">
                        Annuler
                    </a>
                    <button type="submit" class="btn btn-algo-primary">
                        Enregistrer les modifications
                    </button>
                </div>
            </div>

            <!-- Carte interactive -->
            <div class="col-lg-5">
                <div class="card border-0 bg-light p-3 rounded-3 h-100">
                    <h6 class="fw-bold text-dark mb-2">
                        <i class="bi bi-geo-alt-fill text-danger me-1"></i>Ajuster l'emplacement
                    </h6>
                    <div id="editMap" style="height: 380px; width: 100%; border-radius: 8px;"></div>
                </div>
            </div>
        </div>
    </form>
</div>

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            var lat = @Model.Latitude;
            var lng = @Model.Longitude;

            var map = L.map('editMap').setView([lat, lng], 14);
            L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
                attribution: '&copy; OpenStreetMap'
            }).addTo(map);

            var marker = L.marker([lat, lng], { draggable: true }).addTo(map);

            function updateInputs(lt, lg) {
                document.getElementById('inputLatitude').value = lt.toFixed(6);
                document.getElementById('inputLongitude').value = lg.toFixed(6);
            }

            map.on('click', function (e) {
                marker.setLatLng(e.latlng);
                updateInputs(e.latlng.lat, e.latlng.lng);
            });

            marker.on('dragend', function (e) {
                var pos = marker.getLatLng();
                updateInputs(pos.lat, pos.lng);
            });
        });
    </script>
}
