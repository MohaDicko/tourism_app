@model IEnumerable<TourismApp.Web.Models.Evenement>
@{
    ViewData["Title"] = "Gestion des Événements";
}

<div class="content-card">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h4 class="fw-bold mb-1" style="color: #0f172a;">Agenda des Événements</h4>
            <p class="text-muted small mb-0">Événements culturels, festivals et manifestations à Marrakech</p>
        </div>
        <a asp-action="Create" class="btn btn-algo-primary d-inline-flex align-items-center gap-2">
            <i class="bi bi-plus-lg"></i>
            <span>Nouvel Événement</span>
        </a>
    </div>

    <div class="table-responsive">
        <table class="table table-hover table-custom align-middle">
            <thead>
                <tr>
                    <th style="width: 60px;">#</th>
                    <th>Événement</th>
                    <th>Dates</th>
                    <th>Lieu associé</th>
                    <th>Contact</th>
                    <th style="width: 120px;" class="text-center">Action</th>
                </tr>
            </thead>
            <tbody>
                @{
                    int index = 1;
                }
                @foreach (var ev in Model)
                {
                    <tr>
                        <td class="text-muted fw-semibold">@index</td>
                        <td>
                            <div class="d-flex align-items-center gap-3">
                                @if (!string.IsNullOrEmpty(ev.ImageUrl))
                                {
                                    <img src="@ev.ImageUrl" class="rounded" style="width: 48px; height: 38px; object-fit: cover;" alt="@ev.Nom" />
                                }
                                <div>
                                    <div class="fw-semibold text-dark">@ev.Nom</div>
                                    <small class="text-muted line-clamp-1">@ev.Description</small>
                                </div>
                            </div>
                        </td>
                        <td>
                            <div class="small">
                                <span class="d-block text-primary fw-medium"><i class="bi bi-calendar-check me-1"></i>Du @ev.DateDebut.ToString("dd/MM/yyyy")</span>
                                <span class="d-block text-muted"><i class="bi bi-calendar-x me-1"></i>Au @ev.DateFin.ToString("dd/MM/yyyy")</span>
                            </div>
                        </td>
                        <td>
                            @if (ev.Endroit != null)
                            {
                                <span class="badge bg-light text-dark border">
                                    <i class="bi bi-geo-alt me-1 text-danger"></i>@ev.Endroit.Nom
                                </span>
                            }
                            else
                            {
                                <span class="text-muted small">Marrakech</span>
                            }
                        </td>
                        <td>
                            <span class="small fw-semibold text-secondary">
                                @(string.IsNullOrEmpty(ev.Contacte) ? "N/A" : ev.Contacte)
                            </span>
                        </td>
                        <td class="text-center">
                            <form asp-action="Delete" asp-route-id="@ev.Id" method="post" onsubmit="return confirm('Supprimer cet événement ?');" class="d-inline">
                                @Html.AntiForgeryToken()
                                <button type="submit" class="btn btn-sm btn-outline-danger">
                                    <i class="bi bi-trash"></i>
                                </button>
                            </form>
                        </td>
                    </tr>
                    index++;
                }
            </tbody>
        </table>
    </div>
</div>
