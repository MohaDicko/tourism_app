@{
    ViewData["Title"] = "404 - Page non trouvée";
}

<div class="content-card text-center py-5">
    <div style="font-size: 8rem; font-weight: 900; line-height: 1; color: #1e293b; letter-spacing: -3px;">
        404
    </div>
    <h3 class="fw-bold text-dark mt-3 mb-2" style="letter-spacing: 1px;">PAGE NOT FOUND !</h3>
    <p class="text-muted text-uppercase mb-4" style="letter-spacing: 0.5px; font-size: 0.9rem;">
        YOU SEEM TO BE TRYING TO FIND HIS WAY HOME
    </p>

    <div class="mb-5">
        <a asp-controller="Endroits" asp-action="Index" class="btn" style="background-color: #0099cc; color: white; padding: 8px 32px; border-radius: 6px; font-weight: 500;">
            Retour
        </a>
    </div>

    <div class="text-muted small">
        <i class="bi bi-compass me-1 text-info"></i>L'application tourisme de Marrakech vous guide partout.
    </div>
</div>
