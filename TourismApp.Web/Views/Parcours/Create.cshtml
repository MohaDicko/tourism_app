@model TourismApp.Web.ViewModels.ParcoursFormViewModel
@{
    ViewData["Title"] = "Créer un parcours";
    var endroits = ViewBag.Endroits as List<TourismApp.Web.Models.Endroit> ?? new List<TourismApp.Web.Models.Endroit>();
}

<div class="content-card">
    <div class="d-flex justify-content-between align-items-center mb-4 pb-2 border-bottom">
        <h4 class="fw-bold mb-0 text-dark">Nouveau Parcours Touristique</h4>
        <a asp-action="Index" class="btn btn-sm btn-outline-secondary">
            <i class="bi bi-arrow-left me-1"></i>Retour
        </a>
    </div>

    <form asp-action="Create" method="post" enctype="multipart/form-data">
        @Html.AntiForgeryToken()

        <div class="row g-4">
            <div class="col-md-7">
                <div class="mb-3">
                    <label asp-for="Nom" class="form-label text-muted small fw-semibold">Nom du parcours</label>
                    <input asp-for="Nom" class="form-control" placeholder="ex: Circuit de la Palmeraie et Jardins" required />
                    <span asp-validation-for="Nom" class="text-danger small"></span>
                </div>

                <div class="row g-3 mb-3">
                    <div class="col-md-6">
                        <label asp-for="Duree" class="form-label text-muted small fw-semibold">Durée estimée</label>
                        <input asp-for="Duree" class="form-control" placeholder="ex: 2h30" />
                    </div>
                    <div class="col-md-6">
                        <label asp-for="Distance" class="form-label text-muted small fw-semibold">Distance estimée</label>
                        <input asp-for="Distance" class="form-control" placeholder="ex: 5.2 km" />
                    </div>
                </div>

                <div class="mb-3">
                    <label asp-for="Description" class="form-label text-muted small fw-semibold">Description</label>
                    <textarea asp-for="Description" class="form-control" rows="4" placeholder="Présentation du parcours..."></textarea>
                </div>

                <div class="mb-4">
                    <label asp-for="ImageFile" class="form-label text-muted small fw-semibold">Image d'illustration</label>
                    <input asp-for="ImageFile" type="file" class="form-control" accept="image/*" />
                </div>

                <button type="submit" class="btn btn-algo-primary">
                    Créer le parcours
                </button>
            </div>

            <div class="col-md-5">
                <div class="card border-0 bg-light p-3 rounded-3">
                    <h6 class="fw-bold text-dark mb-2">
                        <i class="bi bi-check2-square text-primary me-2"></i>Sélectionner les étapes (dans l'ordre)
                    </h6>
                    <p class="text-muted small">Cochez les sites touristiques à inclure dans ce circuit.</p>
                    <div style="max-height: 380px; overflow-y: auto;">
                        @foreach (var endroit in endroits)
                        {
                            <div class="form-check py-2 border-bottom">
                                <input class="form-check-input" type="checkbox" name="SelectedEndroitIds" value="@endroit.Id" id="end_@endroit.Id">
                                <label class="form-check-label small fw-medium" for="end_@endroit.Id">
                                    @endroit.Nom
                                    <span class="badge bg-secondary-subtle text-secondary ms-1">@endroit.TypeCategorie</span>
                                </label>
                            </div>
                        }
                    </div>
                </div>
            </div>
        </div>
    </form>
</div>
