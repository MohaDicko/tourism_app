@model IEnumerable<TourismApp.Web.Models.Utilisateur>
@{
    ViewData["Title"] = "Profiles des utilisateurs";
}

<div class="content-card">
    <div class="mb-4">
        <h4 class="fw-bold mb-1" style="color: #0f172a;">Profile visiteurs</h4>
        <p class="text-muted small mb-0">The visitors</p>
    </div>

    <div class="table-responsive">
        <table class="table table-hover table-custom align-middle">
            <thead>
                <tr>
                    <th style="width: 70px;">#</th>
                    <th>First Name</th>
                    <th>Last Name</th>
                    <th>Username</th>
                    <th>Email</th>
                    <th>Nationalité</th>
                    <th>Rôle</th>
                </tr>
            </thead>
            <tbody>
                @{
                    int index = 1;
                }
                @foreach (var user in Model)
                {
                    <tr>
                        <td class="text-muted fw-semibold">@index</td>
                        <td class="fw-semibold text-dark">@user.First_Name</td>
                        <td>@user.Last_Name</td>
                        <td>
                            <span class="badge bg-light text-primary border">@@@user.Username</span>
                        </td>
                        <td class="text-secondary small">@user.Email</td>
                        <td>
                            <span class="badge bg-secondary-subtle text-secondary border">
                                @(string.IsNullOrEmpty(user.Nationalite) ? "Non spécifiée" : user.Nationalite)
                            </span>
                        </td>
                        <td>
                            <span class="badge @(user.Role == "Admin" ? "bg-danger" : "bg-success") px-2 py-1">
                                @user.Role
                            </span>
                        </td>
                    </tr>
                    index++;
                }
            </tbody>
        </table>
    </div>
</div>
